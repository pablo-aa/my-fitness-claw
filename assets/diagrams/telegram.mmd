flowchart TB
  YOU(["📱 You, on Telegram"])

  subgraph telegram["Telegram"]
    MGR["Clawdino manager<br/>@clawdino_coach_bot"]
    API["Your bot<br/>@clawdino_1234_bot"]
  end

  subgraph pc["💻 Your computer"]
    TERM["Claude Code<br/>terminal"]
    BOT["Claude Code<br/>bot session"]
    MFC["my-fitness-claw<br/>coach · setup · connect"]
    DATA[("~/my-fitness<br/>profile · plan · log")]
  end

  APPS["Hevy · Garmin"]

  YOU -.->|"① tap to create your bot"| MGR
  MGR -.->|"② bot token, once"| TERM
  YOU <-->|"③ chat every day"| API
