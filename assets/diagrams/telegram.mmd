  BOT -->|"⑤ runs"| MFC
  TERM -->|"runs"| MFC
  MFC <-->|"⑥ reads and writes"| DATA
  APPS -->|"⑦ workouts, sleep"| MFC

  classDef core fill:#d97757,stroke:#d97757,color:#fff
  classDef once stroke-dasharray: 5 5
  class MFC core
  class MGR once
  classDef default fill:#fff,stroke:#bbb,color:#222
  style telegram fill:#fff,stroke:#ddd
  style pc fill:#fff,stroke:#ddd
